{
  "name": "repomonitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:styledev": "node scripts/build-styledev.mjs",
    "docker:build": "docker build --tag \"${DOCKER_IMAGE:-ghcr.io/clammet/repomonitor}:${DOCKER_TAG:-latest}\" .",
    "docker:publish": "docker buildx build --platform \"${DOCKER_PLATFORMS:-linux/amd64,linux/arm64}\" --tag \"${DOCKER_IMAGE:-ghcr.io/clammet/repomonitor}:${DOCKER_TAG:-latest}\" --push .",
    "start": "node .next/standalone/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push && prisma generate",
    "db:reset": "prisma db push --force-reset && prisma generate",
    "google:risc:configure": "node scripts/configure-google-risc.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "jose": "6.2.12",
    "next": "16.3.4",
    "node-cron": "4.6.0",
    "prisma": "7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
