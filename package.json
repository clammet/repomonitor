{
  "name": "repomonitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:styledev": "node scripts/build-styledev.mjs",
    "docker:build": "docker build --tag \"${DOCKER_IMAGE:-ghcr.io/clammet/repomonitor}:${DOCKER_TAG:-latest}\" .",
    "docker:publish": "docker buildx build --platform \"${DOCKER_PLATFORMS:-linux/amd64,linux/arm64}\" --tag \"${DOCKER_IMAGE:-ghcr.io/clammet/repomonitor}:${DOCKER_TAG:-latest}\" --push .",
    "start": "node .next/standalone/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push && prisma generate",
    "db:reset": "prisma db push --force-reset && prisma generate",
    "google:risc:configure": "node scripts/configure-google-risc.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "jose": "6.2.12",
    "next": "16.3.5",
    "node-cron": "4.6.0",
    "prisma": "7.9.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
