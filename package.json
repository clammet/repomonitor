{
  "name": "repomonitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:styledev": "node scripts/build-styledev.mjs",
    "docker:build": "docker build --tag \"${DOCKER_IMAGE:-ghcr.io/clammet/repomonitor}:${DOCKER_TAG:-latest}\" .",
    "docker:publish": "docker buildx build --platform \"${DOCKER_PLATFORMS:-linux/amd64,linux/arm64}\" --tag \"${DOCKER_IMAGE:-ghcr.io/clammet/repomonitor}:${DOCKER_TAG:-latest}\" --push .",
    "start": "node .next/standalone/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push && prisma generate",
    "db:reset": "prisma db push --force-reset && prisma generate",
    "google:risc:configure": "node scripts/configure-google-risc.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "17.4.2",
    "jose": "6.2.9",
    "next": "16.3.1",
    "node-cron": "4.6.0",
    "prisma": "7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
