{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>yuzuyuzuyu/repo-automation:public#v1.0.0",
    ":dependencyDashboard"
  ],
  "rangeStrategy": "pin",
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "minimumReleaseAge": null,
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on monday"
    ],
    "rebaseWhen": "behind-base-branch"
  },
  "packageRules": [
    {
      "description": "The better-sqlite3 build permission must follow Prisma's installed transitive version; do not upgrade the permission independently",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "better-sqlite3"
      ],
      "enabled": false
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:non-major#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:major#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:pre-one#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:action-digest-review#v1.0.0"
      ]
    },
    {
      "description": "engines.node declares the supported range, not a deployment pin; a rangeStrategy=pin rewrite here broke the range once already",
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "description": "One PR for the Node runtime: .nvmrc (what CI tests) and the Dockerfile base image (what ships) must move together",
      "matchDepNames": [
        "node"
      ],
      "groupName": "node runtime"
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:renovate-engine#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:node-runtime#v1.0.0"
      ]
    },
    {
      "description": "Prisma generator, client, adapters, and approved engine scripts must update atomically across npm and regex managers",
      "matchPackageNames": [
        "prisma",
        "@prisma/**"
      ],
      "groupName": "Prisma",
      "groupSlug": "prisma",
      "separateMajorMinor": false
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-3-days#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-7-days#v1.0.0"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep pnpm-workspace.yaml allowBuilds version pins in sync",
      "managerFilePatterns": [
        "/^pnpm-workspace\\.yaml$/"
      ],
      "matchStrings": [
        "\"(?<depName>@?[^\"@]+)@(?<currentValue>[^\">]+)\":\\s*true"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Keep pnpm-workspace.yaml override selectors for next in sync",
      "managerFilePatterns": [
        "/^pnpm-workspace\\.yaml$/"
      ],
      "matchStrings": [
        "\"next@(?<currentValue>[0-9][^\">]*)>"
      ],
      "depNameTemplate": "next",
      "datasourceTemplate": "npm"
    }
  ]
}
