{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    "customManagers:githubActionsVersions"
  ],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on monday"
    ],
    "rebaseWhen": "behind-base-branch"
  },
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Automerge non-major updates once CI is green; rebase onto main first so CI ran against the current base",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Attempt major updates automatically after a week; CI must pass before merge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "dependencyDashboardApproval": false
    },
    {
      "description": "Pre-1.0 updates use the same required CI gate",
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge GitHub Actions digest changes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": false
    },
    {
      "description": "engines.node declares the supported range, not a deployment pin; a rangeStrategy=pin rewrite here broke the range once already",
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "description": "One PR for the Node runtime: .nvmrc (what CI tests) and the Dockerfile base image (what ships) must move together",
      "matchDepNames": [
        "node"
      ],
      "groupName": "node runtime"
    },
    {
      "description": "Renovate engine: several releases a day, so take the weekly one; no digest pin because the annotated RENOVATE_VERSION env var holds a plain tag",
      "matchDepNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "pinDigests": false
    },
    {
      "description": "Keep Node image, CI runtime, and Node types in one tested PR",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "groupName": "Node runtime"
    },
    {
      "description": "Prisma generator, client, adapters, and approved engine scripts must update atomically across npm and regex managers",
      "matchPackageNames": [
        "prisma",
        "@prisma/**"
      ],
      "groupName": "Prisma",
      "groupSlug": "prisma",
      "separateMajorMinor": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep pnpm-workspace.yaml allowBuilds version pins in sync",
      "managerFilePatterns": [
        "/^pnpm-workspace\\.yaml$/"
      ],
      "matchStrings": [
        "\"(?<depName>@?[^\"@]+)@(?<currentValue>[^\">]+)\":\\s*true"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Keep pnpm-workspace.yaml override selectors for next in sync",
      "managerFilePatterns": [
        "/^pnpm-workspace\\.yaml$/"
      ],
      "matchStrings": [
        "\"next@(?<currentValue>[0-9][^\">]*)>"
      ],
      "depNameTemplate": "next",
      "datasourceTemplate": "npm"
    }
  ],
  "timezone": "Australia/Melbourne",
  "rebaseWhen": "behind-base-branch",
  "description": "Renovate owns dependency updates. Tested updates merge after the release soak; unresolved maintenance is reported by the maintenance workflows. See .github/MAINTENANCE.md.",
  "automergeType": "pr",
  "vulnerabilityAlerts": {
    "automerge": true
  }
}
