generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum EmailSource {
  GITHUB
  CUSTOM
}

enum EventType {
  COMMIT
  RELEASE
}

enum ConditionType {
  TEXT_CONTAINS
  LINE_CHANGE
}

enum LineMatchState {
  EXACT
  MOVED
  REMOVED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model User {
  id                  String            @id @default(cuid())
  githubId            String            @unique
  githubLogin         String            @unique
  displayName         String?
  avatarUrl           String?
  notificationEmailId String?
  notificationEmail   EmailAddress?     @relation("SelectedNotificationEmail", fields: [notificationEmailId], references: [id], onDelete: SetNull)
  emailAddresses      EmailAddress[]    @relation("OwnedEmailAddresses")
  githubCredential    GitHubCredential?
  sessions            Session[]
  subscriptions       Subscription[]
  verificationSends   EmailVerificationSend[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model GitHubCredential {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  scopes                String
  expiresAt             DateTime?
  refreshTokenExpiresAt DateTime?
  invalidAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailAddress {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation("OwnedEmailAddresses", fields: [userId], references: [id], onDelete: Cascade)
  email               String
  source              EmailSource
  verifiedAt          DateTime?
  verificationHash    String?     @unique
  verificationExpires DateTime?
  selectedBy          User[]      @relation("SelectedNotificationEmail")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([userId, email])
  @@index([verificationHash])
}

/// One row per verification email sent, so throttles are measured against
/// actual sends rather than inferred from mutable address rows. Rows outside
/// the throttle window are pruned when new sends are recorded.
model EmailVerificationSend {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, email, createdAt])
  @@index([createdAt])
}

model Repository {
  id            String           @id @default(cuid())
  owner         String
  name          String
  fullName      String           @unique
  githubId      String
  defaultBranch String
  isPrivate     Boolean          @default(false)
  htmlUrl       String
  subscriptions Subscription[]
  pollCursors   RepoPollCursor[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([owner, name])
}

model Subscription {
  id           String                   @id @default(cuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository               @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  enabled      Boolean                  @default(true)
  errorCode    String?
  errorMessage String?
  errorAt      DateTime?
  events       SubscriptionEvent[]
  pollCursors  SubscriptionPollCursor[]
  errorAlert   SubscriptionErrorAlert?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([userId, repositoryId])
  @@index([repositoryId, enabled])
  @@index([enabled, errorAt])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           EventType
  enabled        Boolean      @default(true)
  conditions     Condition[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([subscriptionId, type])
  @@index([type, enabled])
}

model Condition {
  id                      String            @id @default(cuid())
  subscriptionEventId     String
  subscriptionEvent       SubscriptionEvent @relation(fields: [subscriptionEventId], references: [id], onDelete: Cascade)
  type                    ConditionType
  note                    String?
  textPattern             String?
  filePath                String?
  lineNumber              Int?
  baselineCommitSha       String?
  baselineLineContent     String?
  lastObservedCommitSha   String?
  lastObservedLineContent String?
  lastObservedLineState   LineMatchState?
  movedLineNumber         Int?
  removedLineNumber       Int?
  notifyOnRemoved         Boolean           @default(true)
  notifyOnMoved           Boolean           @default(true)
  notifyOnChanged         Boolean           @default(true)
  notifications           Notification[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([subscriptionEventId])
}

model RepoPollCursor {
  id               String     @id @default(cuid())
  repositoryId     String
  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  eventType        EventType
  cursor           String
  lastCommitSha    String?
  lastSuccessfulAt DateTime?
  lastError        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([repositoryId, eventType])
}

model SubscriptionPollCursor {
  id               String       @id @default(cuid())
  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType        EventType
  cursor           String
  lastCommitSha    String?
  lastSuccessfulAt DateTime?
  lastError        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([subscriptionId, eventType])
}

model Notification {
  id          String             @id @default(cuid())
  conditionId String
  condition   Condition          @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  eventKey    String
  eventType   EventType
  eventTitle  String
  eventUrl    String
  summary     String
  status      NotificationStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([conditionId, eventKey])
  @@index([status, createdAt])
}

model SubscriptionErrorAlert {
  id             String             @id @default(cuid())
  subscriptionId String             @unique
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  errorCode      String
  message        String
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
}

model PollLease {
  id         String    @id
  owner      String
  leaseUntil DateTime
  lastRunAt  DateTime?
  lastResult String?
  updatedAt  DateTime  @updatedAt
}

model GmailSender {
  id                    String   @id @default("global")
  email                 String
  googleSubject         String?
  refreshTokenEncrypted String
  configuredByUserId    String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GitHubAppConfiguration {
  id                    String    @id @default("global")
  appId                 String
  slug                  String
  clientId              String
  clientSecretEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  refreshTokenEncrypted String?
  refreshTokenExpiresAt DateTime?
  authorizedByUserId    String?
  authorizedGithubLogin String?
  authorizedAt          DateTime?
  configuredByUserId    String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
